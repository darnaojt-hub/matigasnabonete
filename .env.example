# Copy this file to .env for local development (Railway sets these for you
# automatically once a PostgreSQL database is attached to the project — you
# don't need a .env file in production).

# Connection string for your PostgreSQL database.
# Example for a local Postgres: postgres://postgres:postgres@localhost:5432/tindarhan
DATABASE_URL=

# Set to "disable" if your local Postgres doesn't use SSL (most local installs don't).
# Leave unset on Railway.
PGSSLMODE=disable

# Port the Node server listens on. Railway sets this automatically.
PORT=3000

# Optional: password for the "DAR" login, used only the very first time the
# app starts with an empty database. If unset, the default is TINDAHAN —
# change it from the app (sidebar > Change password) right after logging in.
ADMIN_PASSWORD=
